;; sandbox-exec 프로필 템플릿 — scripts/isolated-pytest.sh 가 @이름@ 자리에 realpath 값을 넣어
;; $ISO/profile.sb 로 렌더링한다(직접 쓰지 않는다). 설계 r4 §Q5 ★구성 3, BRIEF 「설계 대비 변경」.
;; 규칙 순서: 같은 동작에 여러 규칙이 걸리면 뒤의 규칙이 이긴다(L2 — preflight 카나리로 확인).
(version 1)
(deny default)
;; Apple 기본 BSD 프로필(libSystem·dyld 초기화용 mach-lookup·IPC·sysctl). 그 안의 쓰기·exec·fork·네트워크 허용은
;; 아래에서 다시 거부해 덮는다(뒤 규칙 우선). 읽기 허용(시스템 경로·/dev·/private/etc 일부)은 남는다 — 정적 검토 로그 참조.
(import "bsd.sb")

;; ---- 프로세스: 인터프리터 실경로만 exec. process-fork 는 허용하지 않는다(N-20 검증 항목).
(deny process-exec*)
(deny process-fork)
(allow process-exec (literal "@VENV_PY@") (literal "@PY_EXE@"))
(allow process-info* (target self))
(allow signal (target self))
(allow sysctl-read)

;; ---- 읽기: 기본 거부. 메타데이터만 경로 전체 허용(r4 C1 의도된 예외 — 내용은 못 읽지만
;;      작업공간 밖 경로의 존재·크기·시각은 노출된다. 경로 해석 없이 인터프리터가 기동하지 못함, N-19와 함께 좁히기 대상).
(allow file-read-metadata)
(allow file-read*
  ;; 시스템 라이브러리·dyld 공유 캐시(N-19: Darwin 27.2 실제 위치 미확정 → 두 후보)
  (subpath "/usr/lib")
  (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS")
  (subpath "/System/Cryptexes/OS")
  (subpath "/private/var/db/timezone")
  (literal "/private/etc/localtime")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/dev/null")
  (literal "/dev/tty")
  ;; worktree 의 플러그인 디렉터리(.venv·.isolation 포함)
  (subpath "@P@")
  ;; 인터프리터: 이 generation 하위만(.hermes-runtime 전체 아님). 2단계 링크 실경로는 N-13b
  (subpath "@PY_HOME@"))
;; 실행 매핑(dyld 공유 캐시·dylib·확장 모듈 .so). file-read* 에 포함되지 않는다(dylib 실행 매핑 필수, L2).
(allow file-map-executable
  (subpath "/usr/lib")
  (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS")
  (subpath "/System/Cryptexes/OS")
  (subpath "@PY_HOME@")
  (subpath "@P@/.venv"))
;; Hermes 소스: 5개 패키지 하위만(hermes-agent 전체 허용 금지). 최상위 *.py 는 N-12 좁히기 절차로 한 줄씩.
;; preflight·probe-guard 는 PYTHONPATH 를 비우므로 이 줄들을 쓰지 않는다.
(allow file-read*
  (subpath "@HERMES_SRC@/agent")
  (subpath "@HERMES_SRC@/cron")
  (subpath "@HERMES_SRC@/gateway")
  (subpath "@HERMES_SRC@/hermes_cli")
  (subpath "@HERMES_SRC@/tools"))

;; ---- 쓰기: 기본 거부(명시 — 뮤테이션 4a 대상 줄). 허용은 $ISO 4개 하위 + /dev/null·/dev/tty 뿐.
(deny file-write*)
(allow file-write*
  (subpath "@ISO@/home")
  (subpath "@ISO@/hermes-home")
  (subpath "@ISO@/tmp")
  (subpath "@ISO@/pycache")
  (literal "/dev/null")
  (literal "/dev/tty"))
(deny file-write* (subpath "@ISO@/canary-deny"))

;; ---- 네트워크: 루프백만(가짜 서버가 127.0.0.1 에서 listen). 루프백 허용은 네트워크 격리의 증거가 아니다.
;; SBPL 의 ip 필터는 호스트로 "localhost" 또는 "*" 만 받는다(L2) — 127.0.0.1 은 localhost 로 표기한다.
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
;; 거부 포트 줄은 래퍼의 DENY_PORTS 한 목록에서 생성된다(운영 8787·8788 + 사람 실행 때만 임의 포트 X).
;;@DENY_PORT_RULES@
